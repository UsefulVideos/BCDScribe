{
    "version": 4,
    "configurations": [
        {
            "name": "Linux",
            "compilerPath": "/usr/bin/g++",
            "intelliSenseMode": "linux-gcc-x64",
            "cppStandard": "c++17",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include",
                "/usr/include/qt6",
                "/usr/include/qt6/QtCore",
                "/usr/include/qt6/QtGui",
                "/usr/include/qt6/QtWidgets",
                "/usr/lib/qt6/mkspecs/linux-g++",
                "/usr/include/qt6/QtCore/6.12.0",
                "/usr/include/qt6/QtCore/6.12.0/QtCore",
                "/usr/include/qt6/QtGui/6.12.0",
                "/usr/include/qt6/QtGui/6.12.0/QtGui",
                "/usr/include/qt6/QtWidgets/6.12.0",
                "/usr/include/qt6/QtWidgets/6.12.0/QtWidgets"
            ],
            "defines": [
                "QT_CORE_LIB",
                "QT_GUI_LIB",
                "QT_WIDGETS_LIB"
            ],
            "compileCommands": [
                "${workspaceFolder}/build/compile_commands.json"
            ]
        }
    ]
}